<?xml version="1.0" encoding="UTF-8"?>

<project name="Compilation de Tetris" default="compile" basedir="." xmlns:ivy="antlib:org.apache.ivy.ant">
	<description>
        Compilation de Tetris avec Ant
    </description>

	<property name="src.dir" location="src" />
	<property name="obj.dir" location="bin" />
	<property name="libs.dir" location="lib" />
	<property name="main.class" value="fr.ubo.tetris.Tetris" />
	<property name="compile.classpath" value="${libs.dir}/commons-lang3-3.5.jar;lib/hamcrest-core-1.3.jar;lib/hamcrest-library-1.3.jar;lib/hamcrest-all-1.3.jar;lib/junit-4.12.jar" />
	<property name="Version" value="1.0.1" />
	<property name="tests.dir" location="test" />
	<property name="tests.results.dir" location="bin/test-results" />
	<property name="tests.reports" location="test-reports" />
	<property name="doc.dir" location="javadoc" />




	<target name="retrieve">
		<ivy:retrieve sync="true" type="jar" />
		<ivy:settings />
		<ivy:resolve />
	</target>
	<target name="init">
		<tstamp />
		<mkdir dir="${obj.dir}" />
		<mkdir dir="${libs.dir}" />
	</target>

	<target name="compile" depends="init,retrieve" description="Compile the source">
		<javac srcdir="${src.dir}" destdir="${obj.dir}" classpath="${compile.classpath}" source="17" target="17" />

		<jar jarfile="${obj.dir}/Tetris.jar" basedir="${obj.dir}">
			<manifest>
				<attribute name="Implementation-Version" value="${Version}" />
				<attribute name="Main-Class" value="${main.class}" />
				<attribute name="Class-Path" value="${compile.classpath}" />
				<attribute name="Built-By" value="Mohamed EL HADDAD" />
			</manifest>
		</jar>
	</target>


	<target name="compile-test" description="Compilation des sources">
		<javac srcdir="${tests.dir}" destdir="${obj.dir}" classpath="${compile.classpath}" source="17" target="17" />
	</target>

	<target name="test" depends="compile-test" description="Tester le projet">
		<mkdir dir="${tests.results.dir}" />

		<junit  printsummary="true" haltonfailure="true" haltonerror="true" showoutput="true">
			<classpath>
				<pathelement path="${obj.dir}" />
				<pathelement path="${compile.classpath}" />
				<pathelement path="lib/hamcrest-core-1.3.jar" />
				<pathelement path="lib/hamcrest-library-1.3.jar" />
				<pathelement path="lib/hamcrest-all-1.3.jar" />
				<pathelement path="lib/junit-4.12.jar" />


			</classpath>
			<batchtest fork="no">
				<fileset dir="${obj.dir}">
					<include name="**/*Test*.class" />
				</fileset>
			</batchtest>
			
			



		</junit>
	</target>

	
	<target name="test-reports" depends="test">
		        <mkdir dir="${tests.reports}" />
		        <junitreport todir="${tests.reports}">
		            <fileset dir="${tests.results.dir}">
		                <include name="*/.xml" />
		            </fileset>
		            <report format="frames" todir="${tests.reports}" />
		        </junitreport>
		    </target>

	
	<target name="javadoc" description="Generate Javadocs">
	    <mkdir dir="${doc.dir}" />
	    <javadoc destdir="${doc.dir}" source="17" classpath="${compile.classpath}">
	        <sourcepath path="${src.dir}" />
	        <packageset dir="src" defaultexcludes="yes">
	            <include name="fr.ubo.tetris" />
	        </packageset>
	    </javadoc>
	</target>



	<target name="clean" description="Clean up">
		<echo message="Suppression des fichiers issus de la compilation" />
		<delete dir="${obj.dir}" />
		<delete dir="${libs.dir}" />
		<delete dir="${tests.reports}" />
		<delete dir="${doc.dir}" />

	</target>
	<target name="all" depends="clean, compile, compile-test, test, test-reports, javadoc" description="Compiler, tester, et générer la documentation du projet">
	    <echo message="Building the project..." />
	</target>

	


</project>
